# Configuración de la aplicación
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:8080
RESET_PASSWORD_URL=http://localhost:5173/reset-password
RESET_PASSWORD_REQUIRES_CHANGE_URL=/reset-password

# Configuración de la base de datos
DB_URL=jdbc:postgresql://localhost:5432/vacaciones_db
DB_USERNAME=postgres
DB_PASSWORD=root

# Configuración de correo electrónico
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion

# Configuración de JWT
JWT_SECRET=tu_clave_secreta_muy_segura
JWT_EXPIRATION_RESET_PASSWORD=30
JWT_EXPIRATION_LOGIN=1440

# Configuración de Google Drive
GOOGLE_DRIVE_CREDENTIALS_PATH=credentials.json
GOOGLE_DRIVE_FOLDER_ROOT=tu_id_de_carpeta

# Configuración del servidor
PORT=8080
CONTEXT_PATH=/api

# Configuración de seguridad
SECURITY_USERNAME=admin
SECURITY_PASSWORD=admin

# Configuración de logging
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG

# Configuración de caché
CACHE_TYPE=none
CAFFEINE_SPEC=maximumSize=500,expireAfterWrite=600s

# Configuración de rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Configuración de CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true 